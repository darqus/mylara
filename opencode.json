{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "steps": 120
    },
    "plan": {
      "steps": 120
    }
  },
  "permission": {
    "bash": "allow"
  },
  "provider": {
    "xkiro": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "xKiro",
      "options": {
        "baseURL": "https://api.xkiro.com/v1",
        "apiKey": "{env:XKIRO_API_KEY}"
      },
      "models": {
        "stealth/big-pickle": { "name": "Big Pickle (Free)" },
        "stealth/space-bunny-alpha:free": { "name": "Space Bunny Alpha (Free)" },
        "qwen/qwen3.8-max": { "name": "Qwen3.8 Max" },
        "mistralai/mistral-large-4-0": { "name": "Mistral Large 4" }
      }
    }
  }
}
