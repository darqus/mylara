VITE_NAME_FULL=MYLARA
VITE_NAME_FULL_EN=MYLARA
VITE_NAME_SHORT=mylara-landing
VITE_KEYWORDS=косметика, уход за лицом, натуральная косметика, MYLARA, красота
VITE_DESCRIPTION=Инновационная косметика по уходу за лицом от MYLARA. Натуральные ингредиенты и эффективные формулы для вашей красоты.

# Public URL of the deployed site (GitHub Pages project site)
VITE_SITE_URL=https://darqus.github.io/mylara

# Legacy API endpoints were retired together with the mylara.ru domain.
# The app talks to Firebase directly (see VITE_FIREBASE_* in CI secrets).
# VITE_HTTPS_PROTOCOL=https:
# VITE_WS_PROTOCOL=ws:
# VITE_API_PORT=
# VITE_API_DOMAIN=api.mylara.ru
# VITE_HTTPS_HOST=https://api.mylara.ru
# VITE_WS_HOST=ws://api.mylara.ru
# VITE_API_VERSION=1
# VITE_API_BASE_HOST=https://api.mylara.ru/api

VITE_ROUTER_BASE=/

VITE_APP_BASE=/

# dark theme [auto, false, true]
VITE_DARK=false

VITE_BUILD_DATE=19.10.2026 21:37:00
VITE_APP_VERSION=0.1.56

# Contact Information
VITE_CONTACT_PHONE=+7 (999) 677-90-67
VITE_CONTACT_EMAIL=contact@example.com
VITE_CONTACT_ADDRESS=г. Москва, ул. Примерная, д. 123

# Social Media Links
VITE_SOCIAL_TELEGRAM_URL=https://t.me/yourusername
VITE_SOCIAL_WHATSAPP_URL=https://wa.me/yourphonenumber
VITE_SOCIAL_INSTAGRAM_URL=https://instagram.com/yourusername
