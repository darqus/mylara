rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Проверка, что пользователь аутентифицирован и имеет роль admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Админ имеет полный доступ ко всем файлам
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
