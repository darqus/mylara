{
  "name": "mylara",
  "version": "0.1.59",
  "description": "Косметика по уходу за лицом",
  "productName": "mylara-landing",
  "author": "darqus",
  "license": "MIT",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "oxlint . && stylelint \"src/**/*.{css,scss}\" && oxfmt --check",
    "fix": "oxlint --fix . && stylelint --fix \"src/**/*.{css,scss}\" && oxfmt",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "quasar prepare",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run",
    "inspect": "quasar inspect --depth",
    "admin:claim": "node scripts/set-admin-claim.mjs",
    "update-env": "node update-env.js",
    "deploy": "npm run update-env && npm run build && cp .nojekyll dist/spa/ && gh-pages -d dist/spa"
  },
  "dependencies": {
    "@quasar/extras": "^1.18.0",
    "firebase": "^11.10.0",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.3",
    "@quasar/quasar-app-extension-testing-unit-vitest": "^3.0.0",
    "@quasar/vite-plugin": "^1.12.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "firebase-admin": "^14.5.0",
    "gh-pages": "^6.1.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.31",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "keywords": [],
  "packageManager": "npm@10.9.2"
}