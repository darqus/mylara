{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Typecheck",
      "type": "shell",
      "command": "npx vue-tsc --noEmit",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "typescript",
        "severity": "error",
        "pattern": [
          {
            "regexp": "^(src/.*)\\((\\d+),(\\d+)\\): error TS\\d+: (.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Found \\d+ error"
        }
      }
    },
    {
      "label": "Lint + Fix",
      "type": "shell",
      "command": "biome check --write --unsafe --files-ignore-unknown=true .",
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false
      },
      "problemMatcher": {
        "owner": "biome",
        "severity": "warning",
        "pattern": [
          {
            "regexp": "^(src/.*):(\\d+):(\\d+) (lint|format|parse|assist) (.*)",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        ]
      }
    },
    {
      "label": "Full Check (Lint + Typecheck)",
      "type": "shell",
      "command": "biome check --write --unsafe --files-ignore-unknown=true . && npx vue-tsc --noEmit",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["Lint + Fix", "Typecheck"],
      "dependsOrder": "sequence",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
